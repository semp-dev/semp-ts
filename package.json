{
  "name": "@sempdev/semp",
  "version": "0.5.7",
  "description": "TypeScript implementation of SEMP (Sealed Envelope Messaging Protocol).",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/semp-dev/semp-ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semp-dev/semp-ts.git"
  },
  "bugs": {
    "url": "https://github.com/semp-dev/semp-ts/issues"
  },
  "keywords": [
    "semp",
    "messaging",
    "e2e",
    "encryption",
    "federation",
    "protocol",
    "sealed-envelope",
    "post-quantum"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./brief": {
      "types": "./dist/brief/index.d.ts",
      "import": "./dist/brief/index.js"
    },
    "./canonical": {
      "types": "./dist/canonical/index.d.ts",
      "import": "./dist/canonical/index.js"
    },
    "./clockskew": {
      "types": "./dist/clockskew/index.d.ts",
      "import": "./dist/clockskew/index.js"
    },
    "./closure": {
      "types": "./dist/closure/index.d.ts",
      "import": "./dist/closure/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "import": "./dist/delivery/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./enclosure": {
      "types": "./dist/enclosure/index.d.ts",
      "import": "./dist/enclosure/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./handshake": {
      "types": "./dist/handshake/index.d.ts",
      "import": "./dist/handshake/index.js"
    },
    "./keys": {
      "types": "./dist/keys/index.d.ts",
      "import": "./dist/keys/index.js"
    },
    "./largeattachment": {
      "types": "./dist/largeattachment/index.d.ts",
      "import": "./dist/largeattachment/index.js"
    },
    "./migration": {
      "types": "./dist/migration/index.d.ts",
      "import": "./dist/migration/index.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "import": "./dist/recovery/index.js"
    },
    "./reputation": {
      "types": "./dist/reputation/index.d.ts",
      "import": "./dist/reputation/index.js"
    },
    "./seal": {
      "types": "./dist/seal/index.d.ts",
      "import": "./dist/seal/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.js"
    },
    "./transparency": {
      "types": "./dist/transparency/index.d.ts",
      "import": "./dist/transparency/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./reasoncodes": {
      "types": "./dist/reasoncodes.d.ts",
      "import": "./dist/reasoncodes.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@noble/post-quantum": "^0.6.1",
    "tr46": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tr46": "^5.0.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
